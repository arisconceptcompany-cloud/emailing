# Frontend React (Vite) — variables de build.
# Copier en `.env` (ou `.env.production`) avant `npm run build`.
#
# URL de l'API FastAPI. Laisser vide en local (même origine via proxy /api).
# En production (frontend sur cPanel), pointer vers l'API du VPS, ex. :
# VITE_API_URL=https://api.aris-cc.com
VITE_API_URL=
